rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function today() { return int((request.time.toMillis() - 10800000) / 86400000) - 20742 + 1; }
    function isInt(x, lo, hi) { return x is int && x >= lo && x <= hi; }
    function isText(x, lo, hi) { return x is string && x.size() >= lo && x.size() <= hi; }
    function data() { return request.resource.data; }
    function isAdmin() { return signedIn() && me() == 'wfHwW9wNrVQWrkWJEgL0qLmMTap2'; }
    // El nombre que se muestra tiene que ser el nombre de usuario reservado por esa cuenta, o el automático JugadorNNN.
    function ownsName(a) { return exists(/databases/$(database)/documents/usernames/$(a.lower()))
      && get(/databases/$(database)/documents/usernames/$(a.lower())).data.uid == me(); }
    function aliasOk(a) { return isText(a, 1, 24) && (a.matches('^Jugador[0-9]{3}$') || ownsName(a)); }
    function isPhoto(x) { return x is string && (x == '' || (x.size() < 40000 && x.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))); }

    match /pistas/{id} {
      allow read: if resource.data.n <= today() || isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && id == string(data().n)
        && data().keys().hasOnly(['n', 'c'])
        && isInt(data().n, 1, 100000)
        && isText(data().c, 2, 40000);
    }

    // Cuándo se editó cada pista, para que los navegadores vuelvan a pedir las que cambiaron
    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'pistas'
        && data().keys().hasOnly(['e'])
        && data().e is map;
    }

    match /players/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['alias', 'ph', 'played', 'won', 'streak', 'best', 'last', 'hw', 'u'])
        && aliasOk(data().alias)
        && isPhoto(data().ph)
        && isInt(data().played, 0, today())
        && isInt(data().won, 0, data().played)
        && isInt(data().best, 0, data().won)
        && isInt(data().streak, 0, data().best)
        && (!('last' in data()) || isInt(data().last, 0, today()))
        && (!('hw' in data()) || isInt(data().hw, 0, 40 * data().won))
        && data().u is int;
      allow delete: if signedIn() && me() == uid;
    }

    match /results/{id} {
      allow read: if true;
      allow create: if signedIn()
        && id == string(data().n) + '_' + me()
        && data().keys().hasOnly(['n', 'u', 'al', 'ph', 'a', 'h', 't'])
        && data().u == me()
        && data().n == today()
        && aliasOk(data().al)
        && isPhoto(data().ph)
        && isInt(data().a, 1, 1000)
        && isInt(data().h, 0, 40)
        && data().t is int;
      allow update: if signedIn()
        && id == string(data().n) + '_' + me()
        && data().keys().hasOnly(['n', 'u', 'al', 'ph', 'a', 'h', 't'])
        && data().u == me()
        && data().n == resource.data.n
        && data().a == resource.data.a
        && data().h == resource.data.h
        && aliasOk(data().al)
        && isPhoto(data().ph);
      allow delete: if signedIn() && resource.data.u == me();
    }

    match /saves/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['hist', 'prog', 'learn', 'votes', 'subs', 'alias', 'uname', 'photo', 'pub', 'showName', 'theme', 'u'])
        && isText(data().alias, 1, 24)
        && isPhoto(data().photo);
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && data().keys().hasOnly(['uid'])
        && data().uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /groups/{code} {
      allow read: if true;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{5}$')
        && data().keys().hasOnly(['name', 'owner', 't'])
        && data().owner == me()
        && isText(data().name, 1, 40);
      allow update: if signedIn() && resource.data.owner == me()
        && data().diff(resource.data).affectedKeys().hasOnly(['name'])
        && isText(data().name, 1, 40);
      allow delete: if signedIn() && resource.data.owner == me();
    }

    match /members/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && id == data().g + '_' + me()
        && data().keys().hasOnly(['g', 'u', 'on', 't'])
        && data().u == me()
        && data().on is bool
        && exists(/databases/$(database)/documents/groups/$(data().g));
    }

    match /votes/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && id == string(data().n) + '_' + me()
        && data().keys().hasOnly(['n', 'u', 'v', 't'])
        && data().u == me()
        && isInt(data().n, 1, today())
        && data().v in ['up', 'down', ''];
      allow delete: if signedIn() && resource.data.u == me();
    }

    match /submissions/{id} {
      allow create: if signedIn()
        && data().keys().hasOnly(['u', 'al', 'pub', 'text', 'answer', 'mechs', 'seg', 'exp', 'hd', 'hi', 'hm', 'extra', 'notes', 't', 'st'])
        && data().u == me()
        && data().st == 'pendiente'
        && data().pub is bool
        && isText(data().al, 0, 24)
        && isText(data().text, 8, 240)
        && isText(data().answer, 2, 30)
        && isText(data().mechs, 1, 300)
        && isText(data().seg, 2, 4000)
        && isText(data().exp, 8, 400)
        && isText(data().hd, 0, 300)
        && isText(data().hi, 0, 300)
        && isText(data().hm, 0, 300)
        && isText(data().extra, 2, 1200)
        && isText(data().notes, 0, 400);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && data().diff(resource.data).affectedKeys().hasOnly(['st'])
        && data().st in ['pendiente', 'aceptada', 'rechazada'];
    }

    match /feedback/{id} {
      allow create: if signedIn()
        && data().keys().hasOnly(['u', 'al', 'kind', 'msg', 't'])
        && data().u == me()
        && isText(data().al, 0, 24)
        && isText(data().kind, 1, 40)
        && isText(data().msg, 5, 1000);
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
